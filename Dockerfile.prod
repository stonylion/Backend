###########
# BUILDER #
###########

# pull official base image
FROM python:3.10-slim AS base

# -----------------------
# system dependencies
# -----------------------
RUN apt-get update && apt-get install -y \
    git \
    ffmpeg \
    build-essential \
    curl \
    mecab \
    libmecab-dev \
    mecab-ipadic-utf8 \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# -----------------------
# workdir
# -----------------------
WORKDIR /app

# -----------------------
# install python deps
# -----------------------
COPY requirements.txt .
RUN pip install --upgrade pip
RUN pip install torch==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install torchaudio==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html

RUN pip install -r requirements.txt

# -----------------------
# copy project files
# -----------------------
COPY . .

# -----------------------
# expose port
# -----------------------
EXPOSE 8000

# -----------------------
# gunicorn run
# -----------------------
CMD ["gunicorn", "Dstonylion.stonylion.wsgi:application", "--bind", "0.0.0.0:8000"]
