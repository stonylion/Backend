FROM python:3.10-slim

# ===== System Dependencies =====
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    git \
    curl \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libpostproc-dev \
    default-libmysqlclient-dev \
    libmecab-dev \
    mecab-ipadic-utf8 \
    && rm -rf /var/lib/apt/lists/*

# ===== Workdir =====
WORKDIR /app

COPY requirements.txt /app/requirements.txt

# ===== Python =====
RUN pip install --upgrade pip

# PyTorch CPU
RUN pip install torch==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install torchaudio==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html

# OpenVoice 요구: numpy==1.22.0 미리 설치
RUN pip install numpy==1.22.0

# 기본 requirements 설치
RUN pip install -r requirements.txt

# ===== Copy project =====
COPY . /app

# ===== Django root =====
WORKDIR /app/Dstonylion

CMD ["gunicorn", "stonylion.wsgi:application", "--bind", "0.0.0.0:8000"]
