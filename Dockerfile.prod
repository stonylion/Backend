FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    default-libmysqlclient-dev \
    build-essential \
    pkg-config \
    git \
    ffmpeg \
    curl \
    libmecab-dev \
    && rm -rf /var/lib/apt/lists/*
    

# 앱 전체가 /app 에 복사됨
WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip
RUN pip install torch==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install torchaudio==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html

RUN pip install -r requirements.txt

COPY . /app

# Django 프로젝트 root는 /app/Dstonylion
WORKDIR /app/Dstonylion

CMD ["gunicorn", "stonylion.wsgi:application", "--bind", "0.0.0.0:8000"]
