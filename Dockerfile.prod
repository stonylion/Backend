FROM python:3.10-slim

# ===== System Dependencies =====
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    git \
    curl \
    ffmpeg \
    libmecab-dev \
    mecab-ipadic-utf8 \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

# ===== Workdir =====
WORKDIR /app
COPY requirements.txt /app/requirements.txt

# ===== Python =====
RUN pip install --upgrade pip
RUN pip install "Cython<3.0"

# faster-whisper (optional)
RUN pip install faster-whisper==0.9.0 --only-binary :all: || true

# PyTorch CPU
RUN pip install torch==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install torchaudio==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html

# OpenVoice numpy
RUN pip install numpy==1.22.0

# 기본 requirements
RUN pip install -r requirements.txt

# ===== MeCab + UniDic (정답) =====
RUN pip install mecab-python3 unidic==1.1.0

RUN python3 -m unidic download --dir /usr/local/lib/python3.10/site-packages/unidic/dicdir

# ===== Copy project =====
COPY . /app

# ===== Django root =====
WORKDIR /app/Dstonylion
CMD ["gunicorn", "stonylion.wsgi:application", "--bind", "0.0.0.0:8000"]
