FROM python:3.10-slim

# ===== System Dependencies =====
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    git \
    curl \
    ffmpeg \
    libmecab-dev \
    mecab-ipadic-utf8 \
    default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

# ===== Workdir =====
WORKDIR /app

COPY requirements.txt /app/requirements.txt

# ===== Python =====
RUN pip install --upgrade pip
RUN pip install "Cython<3.0"

# ---- av 빌드 제거 (OpenVoice에 필요 없음)
# RUN pip install av==10.0.0 --only-binary av

# ---- faster-whisper wheel만 시도, 실패해도 계속
RUN pip install faster-whisper==0.9.0 --only-binary :all: || true

# PyTorch CPU
RUN pip install torch==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html
RUN pip install torchaudio==2.1.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html

# OpenVoice 요구: numpy==1.22.0 미리 설치
RUN pip install numpy==1.22.0

# 기본 requirements 설치
RUN pip install -r requirements.txt

# ===== Copy project =====
COPY . /app

# ===== Django root =====
WORKDIR /app/Dstonylion

CMD ["gunicorn", "stonylion.wsgi:application", "--bind", "0.0.0.0:8000"]
